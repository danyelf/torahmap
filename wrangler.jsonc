{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "torahmap",
  "main": "apps/worker/src/index.ts",
  "compatibility_date": "2026-08-27",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/data/ieeevis/texts.json"],
  },
  // The VIS papers' text, which stays out of git. Kept private: only the Worker reads it.
  "r2_buckets": [{ "binding": "IEEEVIS_TEXTS", "bucket_name": "torahmap-ieeevis" }],
  "analytics_engine_datasets": [{ "binding": "TORAHMAP_EVENTS", "dataset": "torahmap_events" }],
  // The Talmud's and the AI Act's pages each have a subdomain too; Cloudflare Access
  // keeps them, and their paths on torahmap.org, private.
  "routes": [
    { "pattern": "torahmap.org", "custom_domain": true },
    { "pattern": "talmud.torahmap.org", "custom_domain": true },
    { "pattern": "euaiact.torahmap.org", "custom_domain": true },
  ],
  // Each pull request's build gets a public workers.dev link to try it at.
  "preview_urls": true,
}
