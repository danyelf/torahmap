{
  "name": "torahmap",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "sh scripts/install-hooks.sh --warn-only",
    "dev": "vite",
    "harness": "vite --open /test-harness/",
    "build": "node packages/stories/generate.mjs && tsc --project tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:layout": "node scripts/suite-lock.ts playwright test -c test/layout",
    "test:loading": "node scripts/suite-lock.ts playwright test -c test/loading",
    "test:browser": "node scripts/test-browser.ts",
    "video": "node video/render.ts",
    "mix": "node video/mix.ts",
    "rehearse": "vite --open '/video/rehearse.html?script=sample'",
    "capture": "vite --open /video/rehearse.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "node packages/stories/generate.mjs && tsc --project tsconfig.build.json --noEmit && tsc --project tsconfig.test.json --noEmit && tsc --project test/layout/tsconfig.json --noEmit && tsc --project video/tsconfig.json --noEmit && tsc --project scripts/print/tsconfig.json --noEmit && tsc --project test-harness/tsconfig.json --noEmit && tsc --project test/loading/tsconfig.json --noEmit",
    "test:ci": "npm run typecheck && npm run test",
    "validate:haftarah": "tsx scripts/overlays/haftarah/generate.ts",
    "generate:text-dating": "tsx scripts/generate-text-dating.ts",
    "report:click-resolution": "tsx scripts/search/click-resolution-report.ts",
    "report:english-letters": "tsx scripts/search/english-letters-report.ts",
    "print": "node scripts/print/print.ts",
    "generate:text-analytics": "tsx scripts/overlays/text-analytics/generate.ts",
    "report:text-analytics": "tsx scripts/overlays/text-analytics/report.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "^20.19.28",
    "@vitest/coverage-v8": "^4.0.18",
    "happy-dom": "^20.1.0",
    "playwright": "^1.58.2",
    "prettier": "3.9.6",
    "tsx": "4.23.15",
    "typescript": "^7.0.2",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@torahmap/colortestbed": "*",
    "@torahmap/engine": "*",
    "@torahmap/euaiact": "*",
    "@torahmap/link": "*",
    "@torahmap/overlay-catalog": "*",
    "@torahmap/shell": "*",
    "@torahmap/site": "*",
    "@torahmap/stories": "*",
    "@torahmap/talmud": "*",
    "@torahmap/tanakh": "*",
    "@torahmap/telemetry": "*",
    "@torahmap/utils": "*",
    "@torahmap/worker": "*"
  }
}
